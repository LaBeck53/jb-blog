---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { testimonials } from '../data/testimonials';

const featuredTestimonials = testimonials.filter(t => t.featured);
const otherTestimonials = testimonials.filter(t => !t.featured);
---

<BaseLayout title="Témoignages - Julien Bechkri" description="Découvrez les témoignages de mes clients, collaborateurs et managers sur mon expertise en Product Management et transformation agile.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-slate-950 text-white px-6 py-16 md:px-12 md:py-20 mb-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.18),_transparent_22%),radial-gradient(circle_at_80%_30%,_rgba(139,92,246,0.14),_transparent_22%)]\"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.95),_rgba(15,23,42,0.80))]\"></div>
    <div class="relative mx-auto max-w-5xl text-center">
      <p class="text-sm uppercase tracking-[0.32em] text-brand-300 mb-4">Témoignages</p>
      <h1 class="text-4xl md:text-5xl xl:text-6xl font-semibold leading-tight text-white">
        Ce que mes clients et collaborateurs en disent
      </h1>
      <p class="mt-6 mx-auto max-w-3xl text-lg text-slate-300 leading-relaxed">
        Les retours authentiques de mes clients, collaborateurs et anciens directeurs sur mon impact en gestion produit, agilité et transformation digitale.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <div class="max-w-6xl mx-auto px-4 py-20">
    <!-- Featured Testimonials -->
    <div class="mb-20">
      <h2 class="text-3xl font-bold mb-4">Recommandations Principales</h2>
      <p class="text-slate-600 mb-8">Ces témoignages proviennent de mes clients les plus récents et de projets majeurs.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredTestimonials.map((testimonial) => (
          <TestimonialCard testimonial={testimonial} featured={true} />
        ))}
      </div>
    </div>

    <!-- Stats -->
    <div class="rounded-[2rem] bg-brand-50 p-8 md:p-12 mb-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-4xl font-semibold text-brand-600 mb-2">{testimonials.length}+</p>
          <p class="text-slate-600">Témoignages</p>
        </div>
        <div>
          <p class="text-4xl font-semibold text-brand-600 mb-2">15+</p>
          <p class="text-slate-600">Années d'expérience</p>
        </div>
        <div>
          <p class="text-4xl font-semibold text-brand-600 mb-2">100+</p>
          <p class="text-slate-600">Projets livrés</p>
        </div>
        <div>
          <p class="text-4xl font-semibold text-brand-600 mb-2">30+</p>
          <p class="text-slate-600">Entreprises</p>
        </div>
      </div>
    </div>

    <!-- Other Testimonials -->
    <div>
      <h2 class="text-3xl font-bold mb-4">Autres Recommandations</h2>
      <p class="text-slate-600 mb-8">Retours de collaborateurs et anciens directeurs.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {otherTestimonials.map((testimonial) => (
          <TestimonialCard testimonial={testimonial} featured={false} />
        ))}
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <section class="relative overflow-hidden bg-slate-950 text-white px-6 py-16 md:px-12 md:py-20 mt-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.18),_transparent_22%),radial-gradient(circle_at_80%_30%,_rgba(139,92,246,0.14),_transparent_22%)]\"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.95),_rgba(15,23,42,0.80))]\"></div>
    <div class="relative mx-auto max-w-4xl text-center">
      <h2 class="text-4xl md:text-5xl font-semibold mb-6">Prêt à transformer votre approche produit ?</h2>
      <p class="text-xl text-slate-300 mb-8">
        Discutons de vos défis et de comment je peux vous aider à atteindre vos objectifs.
      </p>
      <a href="mailto:julien.bechkri@digilityx.com" class="inline-flex items-center justify-center rounded-full bg-brand-600 px-8 py-4 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700">
        Me Contacter
      </a>
    </div>
  </section>
</BaseLayout>
