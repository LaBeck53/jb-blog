---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page non trouvée">
  <div class="max-w-4xl mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <p class="text-2xl text-gray-600 mb-8">Page non trouvée</p>
    <p class="text-lg text-gray-600 mb-8">
      Désolé, la page que vous recherchez n'existe pas.
    </p>
    <a 
      href="/" 
      class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-8 rounded-lg transition-colors"
    >
      Retour à l'accueil
    </a>
  </div>
</BaseLayout>
