---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout title="Projets - Julien Bechkri" description="Découvrez les projets et expériences clés que j'ai menés">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-5xl font-bold mb-4">Mes Projets</h1>
      <p class="text-xl text-gray-600">
        Une sélection de projets et initiatives que j'ai menés ou auxquels j'ai contribué significativement.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <ProjectCard
        title="Transformation digitale Babilou"
        description="Déploiement international d'un écosystème digital de pilotage qualité (12 pays). Conception et lancement d'une marketplace de services parentaux (BtoBtoC) en vue de sécuriser la croissance business."
        tags={["Digital", "International", "Quality", "Marketplace"]}
      />

      <ProjectCard
        title="Programme Transformation IS&T Alten"
        description="Intégration post-fusion d'une entité IT, pilotage du programme de transformation IS&T (gap analysis, roadmap, data migration, change management). Structuration et déploiement d'un catalogue d'offres digitales."
        tags={["M&A", "Transformation", "Data", "Change Management"]}
      />

      <ProjectCard
        title="Digitalisation Parcours Clients"
        description="Digitalisation de parcours clients bout en bout et refonte de portails extranet adhérents, pro et entreprises (souscription, gestion d'actes, upsells) pour Carac, Generali et Eres."
        tags={["Customer Journey", "Extranet", "B2B", "UX"]}
      />

      <ProjectCard
        title="Plateformes Digitales Corporate"
        description="Cadrage, priorisation & delivery de plateformes digitales (e-commerce, RH, e-learning) pour Chanel, Randstad et Resotainer. Automatisation de workflow et boost IA intégrés."
        tags={["E-commerce", "HR", "E-learning", "AI"]}
      />

      <ProjectCard
        title="Écosystème Digital Pilotage Qualité"
        description="Conception et déploiement d'un écosystème digital complet pour le pilotage qualité opérationnelle, mêlant excellence opérationnelle, expérience utilisateur et innovation."
        tags={["Quality Management", "Operations", "UX", "Innovation"]}
      />

      <ProjectCard
        title="Stratégie Data & Analytics"
        description="Création d'une véritable stratégie data au sein d'organisations, mise en place de gouvernance, formation des équipes, et intégration data dans les processus produit."
        tags={["Data Strategy", "Analytics", "Governance", "Training"]}
      />
    </div>

    <!-- CTA -->
    <section class="mt-20 pt-16 border-t border-gray-200">
      <div class="bg-primary-50 rounded-lg p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">Vous avez un projet similaire ?</h2>
        <p class="text-lg text-gray-600 mb-6">
          Je serais ravi de discuter de comment mon expérience peut contribuer à votre succès.
        </p>
        <a href="#contact" class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-8 rounded-lg transition-colors">
          Parlons de votre projet
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
