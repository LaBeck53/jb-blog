---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout title="Projets - Julien Bechkri" description="Découvrez les projets et expériences clés que j'ai menés">
  <section class="relative overflow-hidden bg-slate-950 text-white px-6 py-16 md:px-12 md:py-20 mb-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.18),_transparent_24%),radial-gradient(circle_at_80%_20%,_rgba(168,85,247,0.14),_transparent_24%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.94),_rgba(15,23,42,0.82))]"></div>
    <div class="relative mx-auto max-w-5xl text-center">
      <p class="text-sm uppercase tracking-[0.32em] text-brand-300 mb-4">Projets</p>
      <h1 class="text-4xl md:text-5xl xl:text-6xl font-semibold leading-tight text-white">
        Des réalisations concrètes qui changent les organisations — explorez le détail.
      </h1>
      <p class="mt-6 mx-auto max-w-3xl text-lg text-slate-300 leading-relaxed">
        Une sélection de missions produit, digitale et organisationnelle menées avec des équipes à forte ambition.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#work" class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700">
          Voir mon travail
        </a>
        <a href="/contact" class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
          Travaillons ensemble
        </a>
      </div>
    </div>
  </section>

  <div id="work" class="max-w-7xl mx-auto px-4 py-4">
    <div class="grid gap-8 lg:grid-cols-2">
      <ProjectCard
        title="Transformation digitale Babilou"
        description="Déploiement international d'un écosystème digital de pilotage qualité (12 pays). Conception et lancement d'une marketplace de services parentaux (BtoBtoC) en vue de sécuriser la croissance business."
        tags={["Digital", "International", "Quality", "Marketplace"]}
      />

      <ProjectCard
        title="Programme Transformation IS&T Alten"
        description="Intégration post-fusion d'une entité IT, pilotage du programme de transformation IS&T (gap analysis, roadmap, data migration, change management). Structuration et déploiement d'un catalogue d'offres digitales."
        tags={["M&A", "Transformation", "Data", "Change Management"]}
      />

      <ProjectCard
        title="Digitalisation Parcours Clients"
        description="Digitalisation de parcours clients bout en bout et refonte de portails extranet adhérents, pro et entreprises (souscription, gestion d'actes, upsells) pour Carac, Generali et Eres."
        tags={["Customer Journey", "Extranet", "B2B", "UX"]}
      />

      <ProjectCard
        title="Plateformes Digitales Corporate"
        description="Cadrage, priorisation & delivery de plateformes digitales (e-commerce, RH, e-learning) pour Chanel, Randstad et Resotainer. Automatisation de workflow et boost IA intégrés."
        tags={["E-commerce", "HR", "E-learning", "AI"]}
      />

      <ProjectCard
        title="Écosystème Digital Pilotage Qualité"
        description="Conception et déploiement d'un écosystème digital complet pour le pilotage qualité opérationnelle, mêlant excellence opérationnelle, expérience utilisateur et innovation."
        tags={["Quality Management", "Operations", "UX", "Innovation"]}
      />

      <ProjectCard
        title="Stratégie Data & Analytics"
        description="Création d'une véritable stratégie data au sein d'organisations, mise en place de gouvernance, formation des équipes, et intégration data dans les processus produit."
        tags={["Data Strategy", "Analytics", "Governance", "Training"]}
      />
    </div>

    <section class="mt-16 rounded-[2rem] bg-brand-50 p-10 text-slate-950">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <div>
          <p class="text-sm uppercase tracking-[0.28em] text-brand-600">Accompagnement</p>
          <h2 class="mt-4 text-3xl font-semibold">Des projets qui mêlent stratégie produit et exécution rapide</h2>
        </div>
        <div class="leading-relaxed text-slate-700">
          J'accompagne la définition de la roadmap, le cadrage produit, et la coordination des équipes pour transformer des idées en produits livrables.
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
