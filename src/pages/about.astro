---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="À Propos - Julien Bechkri" description="Découvrez mon parcours, mon expérience et mes compétences">
  <div class="max-w-4xl mx-auto px-4 py-16">
    <!-- Hero -->
    <div class="mb-16">
      <h1 class="text-5xl font-bold mb-6">Julien Bechkri</h1>
      <p class="text-2xl text-primary-600 font-semibold mb-4">
        Product Manager & Expert en Transformation Digitale
      </p>
      <p class="text-lg text-gray-600">
        Passionné par la création de produits qui font la différence et par la transformation des organisations.
      </p>
    </div>

    <!-- Bio Section -->
    <section class="mb-16 pb-16 border-b border-gray-200">
      <h2 class="text-3xl font-bold mb-6">Qui suis-je ?</h2>
      <div class="space-y-4 text-gray-700">
        <p>
          Avec plus de 10 ans d'expérience en gestion produit et transformation digitale, j'ai accompagné plusieurs organisations dans leur évolution vers des modèles plus agiles et centrés utilisateur.
        </p>
        <p>
          Mon approche combine stratégie, technologie et humanité. Je crois fermement que la transformation digitale doit être avant tout une transformation humaine et culturelle.
        </p>
        <p>
          Vous trouverez sur cette plateforme mon expertise dans : la gestion de produit, la mise en place de l'agilité, le leadership, et l'accompagnement du changement.
        </p>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="mb-16 pb-16 border-b border-gray-200">
      <h2 class="text-3xl font-bold mb-8">Expériences</h2>
      <div class="space-y-8">
        <div class="border-l-4 border-primary-600 pl-6">
          <h3 class="text-xl font-bold mb-2">Position Actuelle</h3>
          <p class="text-gray-600 mb-2">Votre titre actuel • Entreprise • 2024 - Présent</p>
          <p class="text-gray-700">
            Description de votre rôle et des responsabilités principales.
          </p>
        </div>

        <div class="border-l-4 border-gray-300 pl-6">
          <h3 class="text-xl font-bold mb-2">Expérience Précédente</h3>
          <p class="text-gray-600 mb-2">Votre titre précédent • Entreprise • 2020 - 2024</p>
          <p class="text-gray-700">
            Description de votre rôle et des responsabilités principales.
          </p>
        </div>

        <div class="border-l-4 border-gray-300 pl-6">
          <h3 class="text-xl font-bold mb-2">Autres Expériences</h3>
          <p class="text-gray-600 mb-2">À compléter avec vos expériences antérieures</p>
          <p class="text-gray-700">
            Décrivez vos précédents rôles et expériences pertinentes.
          </p>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="mb-16 pb-16 border-b border-gray-200">
      <h2 class="text-3xl font-bold mb-8">Compétences</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-lg font-bold mb-4 text-primary-600">Product Management</h3>
          <ul class="space-y-2 text-gray-700">
            <li>✓ Stratégie produit</li>
            <li>✓ Roadmap & Prioritisation</li>
            <li>✓ User Research & Analytics</li>
            <li>✓ Go-to-Market Strategy</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-bold mb-4 text-primary-600">Agilité & Leadership</h3>
          <ul class="space-y-2 text-gray-700">
            <li>✓ Scrum & Kanban</li>
            <li>✓ Coaching d'équipes</li>
            <li>✓ Gestion du changement</li>
            <li>✓ Culture & Transformation</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-bold mb-4 text-primary-600">Digital & Technologie</h3>
          <ul class="space-y-2 text-gray-700">
            <li>✓ Architecture produit</li>
            <li>✓ Gestion techniques</li>
            <li>✓ Data & Analytics</li>
            <li>✓ Intégration AI/ML</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-bold mb-4 text-primary-600">Autres</h3>
          <ul class="space-y-2 text-gray-700">
            <li>✓ Formation & Mentoring</li>
            <li>✓ Présentation & Communication</li>
            <li>✓ Gestion de projets complexes</li>
            <li>✓ Accompagnement du changement</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section>
      <h2 class="text-3xl font-bold mb-8">Formation</h2>
      <div class="space-y-6">
        <div>
          <h3 class="text-lg font-bold">Formation à ajouter</h3>
          <p class="text-gray-600">École/Université • 20XX - 20XX</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
