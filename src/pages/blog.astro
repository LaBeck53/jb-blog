---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout title="Blog - Julien Bechkri" description="Mes articles et réflexions sur la gestion produit, l'agilité et la transformation digitale">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-5xl font-bold mb-4">Articles & Réflexions</h1>
      <p class="text-xl text-gray-600">
        Mes pensées sur la gestion de produit, l'agilité, la transformation digitale, et le leadership.
      </p>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      <ArticleCard
        title="Les 5 principes clés de la gestion agile"
        description="Découvrez les fondamentaux de l'agilité et comment les appliquer dans votre contexte d'entreprise."
        date="2026-04-15"
        tags={["Agilité", "Management"]}
        external={true}
        url="https://blog-entreprise.com/article-1"
      />

      <ArticleCard
        title="Product Management : Vision vs Exécution"
        description="Comment trouver l'équilibre entre une vision ambitieuse et une exécution pragmatique."
        date="2026-04-10"
        tags={["Product", "Stratégie"]}
        external={true}
        url="https://blog-entreprise.com/article-2"
      />

      <ArticleCard
        title="Transformation digitale : Au-delà de la technologie"
        description="La transformation digitale, c'est d'abord une question de culture et de mindset."
        date="2026-04-05"
        tags={["Digital", "Transformation"]}
        external={true}
        url="https://blog-entreprise.com/article-3"
      />

      <ArticleCard
        title="Métriques produit : Au-delà des vanity metrics"
        description="Quelles métriques vraiment importent pour votre produit et comment les suivre efficacement."
        date="2026-03-28"
        tags={["Analytics", "Product"]}
        external={true}
        url="https://blog-entreprise.com/article-4"
      />

      <ArticleCard
        title="Conduire le changement sans consulter personne"
        description="Les secrets pour accompagner une transformation organisationnelle réussie."
        date="2026-03-20"
        tags={["Leadership", "Change"]}
        external={true}
        url="https://blog-entreprise.com/article-5"
      />

      <ArticleCard
        title="User Research : Aller au-delà des hypothèses"
        description="Comment vraiment comprendre vos utilisateurs et valider vos hypothèses produit."
        date="2026-03-12"
        tags={["UX", "Research"]}
        external={true}
        url="https://blog-entreprise.com/article-6"
      />
    </div>

    <!-- Info Box -->
    <div class="bg-primary-50 rounded-lg p-8 text-center">
      <h2 class="text-2xl font-bold mb-4">Plus d'articles à venir</h2>
      <p class="text-gray-600 mb-6">
        Je suis actuellement en train de consolider et publier mes articles. Les liens ci-dessus pointent vers ma blog/plateforme actuelle. Bientôt, les nouveaux articles seront publiés directement ici !
      </p>
    </div>
  </div>
</BaseLayout>
