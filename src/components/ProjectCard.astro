---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  link?: string;
  external?: boolean;
}

const { title, description, tags = [], link, external = true } = Astro.props;
---

<article class="group overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_18px_60px_-35px_rgba(15,23,42,0.45)] transition hover:-translate-y-1 hover:shadow-[0_24px_80px_-38px_rgba(15,23,42,0.45)]">
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-500 via-cyan-500 to-purple-500"></div>
  <div class="flex h-full flex-col gap-6 p-8 pt-10">
    {link ? (
      <a
        href={link}
        target={external ? "_blank" : "_self"}
        rel={external ? "noopener noreferrer" : ""}
        class="text-2xl font-semibold text-slate-950 transition-colors group-hover:text-brand-600"
      >
        {title}
        {external && <span class="ml-2 text-base text-slate-400">↗</span>}
      </a>
    ) : (
      <h3 class="text-2xl font-semibold text-slate-950">{title}</h3>
    )}

    <p class="text-slate-600 flex-grow leading-relaxed">
      {description}
    </p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-200">
        {tags.map(tag => (
          <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-sm font-medium text-brand-700">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
