---
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
  featured?: boolean;
}

const { testimonial, featured = false } = Astro.props;

const shortName = (name: string) => {
  const parts = name.trim().split(' ');
  if (parts.length <= 1) return name;
  return `${parts[0]} ${parts[parts.length - 1].charAt(0)}.`;
};

const displayName = shortName(testimonial.name);
---

{featured ? (
  <article class="group relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_18px_60px_-35px_rgba(15,23,42,0.45)] transition hover:-translate-y-1 hover:shadow-[0_24px_80px_-38px_rgba(15,23,42,0.45)]">
    <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-500 via-cyan-500 to-purple-500"></div>
    <div class="flex flex-col gap-6 p-8 pt-10">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white font-semibold flex-shrink-0">
          {testimonial.name.charAt(0)}
        </div>
        <div>
          <p class="font-semibold text-slate-950">{displayName}</p>
          <p class="text-sm text-slate-600">{testimonial.title}</p>
          <p class="text-xs text-brand-600 font-medium">{testimonial.company}</p>
        </div>
      </div>
      <blockquote class="text-lg leading-relaxed text-slate-700 italic border-t border-slate-100 pt-6">
        "{testimonial.text}"
      </blockquote>
    </div>
  </article>
) : (
  <div class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_18px_60px_-35px_rgba(15,23,42,0.45)] transition hover:-translate-y-1 hover:shadow-[0_24px_80px_-38px_rgba(15,23,42,0.45)]">
    <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-500 via-cyan-500 to-purple-500"></div>
    <div class="flex flex-col gap-6 p-8 pt-10">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white text-sm font-semibold flex-shrink-0">
          {testimonial.name.charAt(0)}
        </div>
        <div>
          <p class="font-semibold text-sm text-slate-950">{displayName}</p>
          <p class="text-xs text-slate-600">{testimonial.title} @ {testimonial.company}</p>
        </div>
      </div>
      <blockquote class="text-slate-700 leading-relaxed line-clamp-4 italic border-t border-slate-100 pt-6">
        "{testimonial.text}"
      </blockquote>
    </div>
  </div>
)}
