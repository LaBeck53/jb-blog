---
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
  featured?: boolean;
}

const { testimonial, featured = false } = Astro.props;
---

{featured ? (
  <div class="bg-gradient-to-br from-blue-50 to-orange-50 border border-blue-200 rounded-xl p-8 hover:shadow-lg transition-shadow duration-300">
    <div class="flex items-start gap-4 mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-blue-600 to-orange-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
        {testimonial.name.charAt(0)}
      </div>
      <div class="flex-1">
        <h4 class="font-semibold text-gray-900">{testimonial.name}</h4>
        <p class="text-sm text-gray-600">{testimonial.title}</p>
        <p class="text-xs text-orange-600 font-medium">{testimonial.company}</p>
      </div>
    </div>
    <blockquote class="border-l-4 border-orange-500 pl-4 italic text-gray-700 mb-4">
      "{testimonial.text}"
    </blockquote>
    {testimonial.date && (
      <p class="text-xs text-gray-500">{testimonial.date}</p>
    )}
  </div>
) : (
  <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow duration-300">
    <blockquote class="text-gray-700 mb-4 line-clamp-3">
      "{testimonial.text}"
    </blockquote>
    <div class="pt-4 border-t border-gray-100">
      <p class="font-semibold text-sm text-gray-900">{testimonial.name}</p>
      <p class="text-xs text-gray-600">{testimonial.title} @ {testimonial.company}</p>
    </div>
  </div>
)}
