---
interface Props {
  title: string;
  description: string;
  date: string;
  slug?: string;
  tags?: string[];
  external?: boolean;
  url?: string;
  category?: string;
  eyecatchImage?: string;
}

const { title, description, date, slug, tags = [], external = false, url, category = '', eyecatchImage } = Astro.props;
const href = url || `/blog/${slug}`;

const hashCode = (value: string) => [...value].reduce((acc, char) => char.charCodeAt(0) + ((acc << 5) - acc), 0);
const seed = Math.abs(hashCode(title));
const palettes = [
  ['#7C3AED', '#22D3EE', '#A78BFA'],
  ['#2563EB', '#38BDF8', '#93C5FD'],
  ['#0EA5E9', '#22C55E', '#38BDF8'],
  ['#9333EA', '#F472B6', '#C4B5FD'],
  ['#0F766E', '#2DD4BF', '#99F6E4'],
  ['#F97316', '#FBBF24', '#FDBA74'],
];
const palette = palettes[seed % palettes.length];
const [colorA, colorB, colorC] = palette;
const gradientBackground = `linear-gradient(135deg, ${colorA} 0%, ${colorB} 65%)`;
const shapeStyle1 = `background: radial-gradient(circle, ${colorC} 16%, transparent 60%);`;
const shapeStyle2 = `background: radial-gradient(circle, ${colorB} 18%, transparent 55%);`;
const shapeStyle3 = `background: radial-gradient(circle, ${colorA} 14%, transparent 50%);`;
---

<article class="group overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_18px_60px_-35px_rgba(15,23,42,0.45)] transition hover:-translate-y-1 hover:shadow-[0_24px_80px_-38px_rgba(15,23,42,0.45)]">
  <div class="relative h-48 overflow-hidden">
    {eyecatchImage ? (
      <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${eyecatchImage}')`}></div>
    ) : (
      <div class="absolute inset-0" style={`background: ${gradientBackground};`}></div>
    )}
    {!eyecatchImage && (
      <>
        <div class="absolute -left-10 -top-10 h-28 w-28 rounded-full opacity-80" style={shapeStyle1}></div>
        <div class="absolute right-6 top-12 h-20 w-20 rounded-full opacity-70" style={shapeStyle2}></div>
        <div class="absolute left-16 bottom-0 h-32 w-32 rounded-full opacity-40 blur-2xl" style={shapeStyle3}></div>
      </>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
    <div class="absolute left-4 top-4 rounded-full border border-white/10 bg-white/90 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.28em] text-slate-950 shadow-sm">
      {category || 'Autre'}
    </div>
  </div>

  <div class="relative flex flex-col gap-4 p-7">
    <time class="text-sm uppercase tracking-[0.24em] text-slate-400">
      {new Date(date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>

    <a
      href={href}
      target={external ? "_blank" : "_self"}
      rel={external ? "noopener noreferrer" : ""}
      class="text-2xl font-semibold text-slate-950 transition-colors group-hover:text-brand-600"
    >
      {title}
      {external && <span class="ml-2 text-base text-slate-400">↗</span>}
    </a>

    <p class="text-slate-600 line-clamp-3 leading-relaxed">
      {description}
    </p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-2">
        {tags.map(tag => (
          <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
