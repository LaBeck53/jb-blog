---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-100 mt-20">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- About -->
      <div>
        <h3 class="text-lg font-bold mb-4">Julien Bechkri</h3>
        <p class="text-gray-400">
          Digital Transformation & Organisation - Head of Product Management. Spécialiste en IA & Automation, Vision & Product Strategy, Innovation et Delivery Lead.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-bold mb-4">Navigation</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/" class="hover:text-primary-400 transition">Accueil</a></li>
          <li><a href="/about" class="hover:text-primary-400 transition">À Propos</a></li>
          <li><a href="/projects" class="hover:text-primary-400 transition">Projets</a></li>
          <li><a href="/blog" class="hover:text-primary-400 transition">Blog</a></li>
          <li><a href="/testimonials" class="hover:text-primary-400 transition">Témoignages</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-lg font-bold mb-4">Contact</h4>
        <ul class="space-y-2 text-gray-400">
          <li>
            <a href="mailto:julien.bechkri@digilityx.com" class="hover:text-primary-400 transition">
              Email
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/jbechkri/" target="_blank" rel="noopener noreferrer" class="hover:text-primary-400 transition">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-primary-400 transition">
              Twitter
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800 pt-8">
      <p class="text-center text-gray-400">
        © {currentYear} Julien Bechkri. All rights reserved.
      </p>
    </div>
  </div>
</footer>
