---
interface Feature {
  title: string;
  description: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  ctaPrimary?: { text: string; href: string };
  ctaSecondary?: { text: string; href: string };
  features?: Feature[];
}

const {
  title = "Transformer la complexité en impact durable.",
  subtitle = "J'accompagne les organisations IT et Produit à piloter par la valeur, faire les bons choix et délivrer ce qui compte vraiment.",
  ctaPrimary = { text: "DÉCOUVRIR MON EXPERTISE", href: "/about" },
  ctaSecondary = { text: "VOIR DES RÉALISATIONS", href: "/projects" },
  features = [
    { title: "STRUCTURE", description: "Clarifier l'organisation et les interactions pour gagner en efficacité." },
    { title: "DECIDE", description: "Prioriser ce qui crée vraiment de la valeur et sécuriser les décisions." },
    { title: "DELIVER", description: "Délivrer avec impact, mesurer les résultats et améliorer en continu." },
  ],
} = Astro.props;
---

<section class="relative overflow-hidden bg-slate-950 text-white">
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-950 to-slate-900"></div>

  <div class="pointer-events-none absolute -top-20 left-1/2 w-96 h-96 -translate-x-1/2 rounded-full bg-blue-500/20 blur-3xl opacity-40" style="animation: float 12s ease-in-out infinite;"></div>
  <div class="pointer-events-none absolute top-24 -left-32 w-72 h-72 rounded-full bg-cyan-400/20 blur-3xl opacity-35" style="animation: float 10s ease-in-out infinite 1s;"></div>
  <div class="pointer-events-none absolute bottom-0 right-0 w-96 h-96 rounded-full bg-purple-500/20 blur-3xl opacity-30" style="animation: float 14s ease-in-out infinite 2s;"></div>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.90),_rgba(15,23,42,0.75))]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,_rgba(56,189,248,0.12),_transparent_20%),radial-gradient(circle_at_85%_35%,_rgba(168,85,247,0.08),_transparent_25%))]"></div>

  <div class="relative max-w-7xl mx-auto px-4 py-24 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <div class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.32em] text-slate-200 shadow-[0_10px_60px_-35px_rgba(15,23,42,0.8)]">
          JB Product Systems
        </div>
        <h1 class="text-4xl md:text-5xl xl:text-6xl font-semibold leading-tight tracking-[-0.03em] text-white">
          {title}
        </h1>
        <p class="max-w-xl text-lg md:text-xl text-slate-300 leading-relaxed">
          {subtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href={ctaPrimary.href} class="inline-flex items-center justify-center rounded-full bg-brand-600 px-8 py-4 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700">
            {ctaPrimary.text}
          </a>
          <a href={ctaSecondary.href} class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-8 py-4 text-sm font-semibold text-white transition hover:bg-white/10 hover:border-white/40">
            {ctaSecondary.text}
          </a>
        </div>
      </div>

      <div class="relative rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-[0_35px_120px_-45px_rgba(15,23,42,0.9)] backdrop-blur-xl">
        <div class="grid gap-6 lg:grid-cols-3 lg:divide-x lg:divide-white/10">
          {features.map((feature, index) => (
            <div class={`${index > 0 ? 'lg:pl-6' : ''} ${index < features.length - 1 ? 'lg:pr-6' : ''}`}>
              <div class="flex items-center gap-4 mb-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-3xl bg-slate-950 text-brand-500 border border-white/10 shadow-sm shadow-slate-950/20">
                  {feature.title === 'STRUCTURE' ? (
                    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="7" height="7" rx="1.5" />
                      <rect x="14" y="3" width="7" height="7" rx="1.5" />
                      <rect x="3" y="14" width="7" height="7" rx="1.5" />
                      <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                  ) : feature.title === 'DECIDE' ? (
                    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="7" />
                      <path d="M12 5v3" />
                      <path d="M12 16v3" />
                      <path d="M5 12h3" />
                      <path d="M16 12h3" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 12h16" />
                      <path d="M14 6l6 6-6 6" />
                    </svg>
                  )}
                </div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-white">{feature.title}</h3>
              </div>
              <p class="text-sm leading-relaxed text-slate-300">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) translateX(0px);
      opacity: 0.4;
    }
    25% {
      transform: translateY(-18px) translateX(12px);
      opacity: 0.5;
    }
    50% {
      transform: translateY(-36px) translateX(-12px);
      opacity: 0.35;
    }
    75% {
      transform: translateY(-18px) translateX(16px);
      opacity: 0.45;
    }
  }
</style>
